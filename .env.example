# Copy to .env before running docker compose. .env is gitignored.

# NVIDIA API key read by the OpenCode server inside the container.
# The built-in `nvidia` provider picks this up automatically.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BaryGraph MCP endpoint as seen from inside the container.
# The compose files use host networking, so 127.0.0.1 reaches a BaryGraph
# running on the Docker host. For bridge networking, use
# http://host.docker.internal:8000/mcp plus the extra_hosts mapping described
# in README.md; for a remote machine, use its address.
BARYGRAPH_MCP_URL=http://127.0.0.1:8000/mcp

# Host port for the web UI.
MEMORY_BUILDER_WEB_PORT=8765

# Optional: log level for the app.
# MEMORY_BUILDER_LOG=INFO

# Optional values for docker-compose.multi.yml
# (two loops, two keys, two ports):
# NVIDIA_API_KEY_1=nvapi-...
# NVIDIA_API_KEY_2=nvapi-...
# MEMORY_BUILDER_WEB_PORT_1=8765
# MEMORY_BUILDER_WEB_PORT_2=8766
